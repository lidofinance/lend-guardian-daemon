# Ethereum mainnet JSON-RPC with debug_traceTransaction (callTracer) support
RPC_URL=
# Blockscout API key for the viewer's address labels and the blockscout-tags provider floor
BLOCKSCOUT_API_KEY=
# Viewer: port and the label request budget per loaded transaction (defaults shown)
VIEWER_PORT=8787
VIEWER_MAX_REQUESTS=20
# Viewer: the dataset under cache/datasets the tracker answers from (default shown)
VIEWER_DATASET=wsteth-weth
